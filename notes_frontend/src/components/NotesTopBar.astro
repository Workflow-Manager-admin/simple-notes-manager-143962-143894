---
/**
 * NotesTopBar.astro
 * Top action bar for main area: includes Save/Edit/Delete, tags display/input
 * Props:
 *   editing: Boolean, whether in edit mode
 *   onEdit: function, switches to edit mode
 *   onSave: function, saves note
 *   onDelete: function, deletes note
 *   onBack: function, returns to list (mobile)
 *   canEdit: boolean, disables edit
 *   canSave: boolean, disables save
 *   canDelete: boolean, disables delete
 *   tags: string[], current tags for note
 *   onTagInput: function for tag input change
 *   tagInputValue: string (value in tag input)
 *   onAddTag: function to add tag
 *   onRemoveTag: function to remove a tag
 *   showBack: boolean (for mobile navigation)
 */
const {
  editing = false,
  onEdit = () => {},
  onSave = () => {},
  onDelete = () => {},
  onBack = () => {},
  canEdit = true,
  canSave = true,
  canDelete = true,
  tags = [],
  onTagInput = () => {},
  tagInputValue = "",
  onAddTag = () => {},
  onRemoveTag = () => {},
  showBack = false,
} = Astro.props;
---

<header class="notes-topbar">
  {showBack &&
    <button class="back-btn" title="Back" onClick={onBack}>&larr;</button>
  }

  <div class="tags-group">
    <span class="tag-label">Tags:</span>
    {tags.map(tag => (
      <span class="main-tag">
        {tag}
        <button class="tag-remove" tabIndex={editing ? 0 : -1} onClick={() => editing && onRemoveTag(tag)} title="Remove tag" aria-label={"Remove tag " + tag} disabled={!editing}>×</button>
      </span>
    ))}
    {editing && (
      <form class="tag-form" onSubmit={e => {e.preventDefault(); onAddTag();}}>
        <input class="tag-input"
          type="text"
          placeholder="Add tag"
          value={tagInputValue}
          onInput={e => onTagInput(e.target.value)}
          aria-label="Add new tag"
          size={7}
          maxLength={20}
        />
        <button class="tag-add-btn" type="submit" title="Add tag" disabled={!tagInputValue.trim()}>+</button>
      </form>
    )}
  </div>

  <div class="topbar-actions">
    {!editing && (
      <button class="edit-btn" title="Edit" disabled={!canEdit} onClick={onEdit}>Edit</button>
    )}
    {editing && (
      <button class="save-btn" title="Save" disabled={!canSave} onClick={onSave}>Save</button>
    )}
    <button class="delete-btn" title="Delete" disabled={!canDelete} onClick={onDelete}>Delete</button>
  </div>
</header>

<style>
.notes-topbar {
  width: 100%;
  display: flex;
  align-items: flex-start;
  padding: 0.65em 1.2em;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border-color);
  gap: 0.7em;
  flex-wrap: wrap;
}

.back-btn {
  background: none;
  border: none;
  font-size: 1.5em;
  color: #1976d2;
  margin-right: 0.5em;
  cursor: pointer;
}

.tags-group {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 0.4em;
  flex-wrap: wrap;
}
.main-tag {
  background: #ffb300;
  color: #442800;
  padding: 0.19em 0.62em;
  border-radius: 999px;
  font-size: 0.93em;
  display: inline-flex;
  align-items: center;
  gap: 0.25em;
  margin-right: 0.14em;
}
.tag-remove {
  background: transparent;
  border: none;
  margin-left: 0.08em;
  color: #884800;
  font-weight: bold;
  cursor: pointer;
}
.tag-label {font-weight:bold;font-size:0.9em;margin-right:0.4em;}

.tag-form {
  display: inline-flex;
  align-items: center;
  gap: 0.2em;
}
.tag-input {
  padding: 0.2em 0.6em;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  font-size: 0.93em;
  min-width: 4em;
  margin-left:0.2em;
  background: var(--bg-color);
  color: var(--text-color);
}
.tag-add-btn {
  background: #1976d2;
  color: white;
  border: none;
  margin-left:0.1em;
  padding: 0.12em 0.45em;
  border-radius: 7px;
  font-size: 1.09em;
  cursor: pointer;
}
.tag-add-btn:disabled {
  background: #c8daf6;
  color: #808080;
  cursor: not-allowed;
}

/* Topbar right actions */
.topbar-actions {
  display: flex;
  gap: 0.4em;
}
.edit-btn, .save-btn, .delete-btn {
  border: none;
  border-radius: 8px;
  font-size: 1.03em;
  font-weight: 500;
  padding: 0.22em 0.98em;
  margin-left: 2px;
  cursor: pointer;
  transition: background 0.13s;
}
.edit-btn {
  background: #1976d2;
  color: #fff;
}
.edit-btn:disabled {background: #e3edfb; color: #8ca7cc;}
.save-btn {
  background: #ffb300;
  color: #222;
}
.save-btn:disabled {background: #ffeac0; color: #a88b41;}
.delete-btn {
  background: #faf8f6;
  color: #424242;
  border: 1px solid #ffaa00;
}
.delete-btn:disabled {background: #f3e5e5; color: #b9b9b9;}

@media (max-width: 600px) {
  .notes-topbar {
    padding: 0.51em 0.4em;
  }
  .edit-btn, .save-btn, .delete-btn {
    font-size: 1em;
    padding: 0.15em 0.5em;
  }
}
</style>
